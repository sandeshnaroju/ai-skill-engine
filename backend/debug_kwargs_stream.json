ams(pdf_path)\\nprint(f\\\"Successfully decoded {len(decoded)} streams.\\\")\\nfor obj_num, dict_part, text in decoded:\\n    # Let's see if this contains text (like TJ, Tj, or general text)\\n    # Print the first 100 characters of the decoded stream if it looks like ASCII\\n    if b'BT' in text or b'Tj' in text or b'TJ' in text:\\n        print(f\\\"--- Obj {obj_num} contains text-like operators ---\\\")\\n        # Let's clean up or print some parts of it\\n        print(\\\"Length:\\\", len(text))\\n        # Let's print a part\\n        print(text[:300])\\n\"}"
